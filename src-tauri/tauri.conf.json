{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "MPO-pro Beta",
  "version": "7.0.0-beta.13",
  "identifier": "com.mpopro.beta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:15421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MPO-pro Beta — Media Player Studio & Dashboard",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "MPO-pro Beta Floating Overlay",
        "url": "/index.html?mode=hud",
        "width": 640,
        "height": 220,
        "x": 60,
        "y": 60,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
